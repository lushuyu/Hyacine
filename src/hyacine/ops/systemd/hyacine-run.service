# systemd user service — one-shot daily hyacine run, triggered by .timer.
# Install: ~/.config/systemd/user/hyacine-run.service
# Assumes the repo is cloned at ~/hyacine with `uv sync` run. Edit
# WorkingDirectory / EnvironmentFile / ExecStart if you keep it elsewhere.

[Unit]
Description=Hyacine pipeline run
# No After=/Wants=network-online.target: a systemd *user* manager has no such
# target, so those lines did nothing. A network that isn't up yet at start-up
# is covered by the Restart= retry below.
# Retry budget: at most 3 starts (first run + 2 retries) per 4h, so a hard
# failure (expired token, broken config) gives up instead of looping. Once
# the limit is hit, manual starts ("Run now") are refused too until the
# window passes or `systemctl --user reset-failed hyacine-run.service`.
StartLimitIntervalSec=4h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/hyacine
EnvironmentFile=%h/hyacine/.env
# systemd's default user PATH omits ~/.local/bin, where the official Claude
# Code installer drops the `claude` binary. Pin PATH so the subprocess in
# hyacine.llm.claude_code can resolve it. (HYACINE_CLAUDE_BIN in .env wins
# over PATH if the operator wants to point at a non-default location.)
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
ExecStart=%h/hyacine/.venv/bin/python -m hyacine.pipeline.run
# The timer's Persistent=true only replays a trigger missed while the host was
# off; it never retries a run that failed. Restart= does. Retrying is safe:
# the watermark only advances after a successful send, so a retry re-fetches
# the same window instead of skipping mail.
# Restart= on a Type=oneshot unit needs systemd >= 244; older versions refuse
# to load the unit, so drop Restart=/RestartSec= there.
Restart=on-failure
RestartSec=15min
# oneshot units have no start timeout by default; bound a hung run (the LLM
# call alone is capped by llm_timeout_seconds). Hitting it counts as a failure
# and is retried like one.
TimeoutStartSec=40min

# Same hardening profile as the web unit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# %h/.IdentityService is where msal-extensions persists the Graph token
# cache (path is not relocatable). Without it writable, MSAL can't refresh
# the token and Graph auth silently dies on next refresh.
ReadWritePaths=%h/hyacine/data %h/hyacine/prompts %h/hyacine/config %h/.IdentityService
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute disabled: claude 2.1.x ships as a single ELF binary
# with embedded JIT. W^X enforcement traps the JIT and the subprocess dies
# with SIGTRAP (empty stdout/stderr, no useful diagnostics). Re-enable only
# if upstream ever switches to an AOT runtime.
# MemoryDenyWriteExecute=true
SystemCallArchitectures=native
