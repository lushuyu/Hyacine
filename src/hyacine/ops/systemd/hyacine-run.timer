# systemd user timer — fires hyacine-run.service once a day.
# Install: ~/.config/systemd/user/hyacine-run.timer
# Enable:  systemctl --user enable --now hyacine-run.timer
#
# NOTE: Nothing generates this file. OnCalendar is edited by hand to match
# run_time in ./config/config.yaml (then `systemctl --user daemon-reload`).

[Unit]
Description=Daily trigger for hyacine-run.service

[Timer]
# Fires at 07:30 in the host's timezone (`timedatectl`). OnCalendar can carry
# an IANA zone suffix (systemd >= 242) to follow config.yaml's timezone
# regardless of the host's, e.g.
#   OnCalendar=*-*-* 07:30:00 Asia/Singapore
OnCalendar=*-*-* 07:30:00
# If the host was off at 07:30, fire on next start. Critical for laptops/WSL.
Persistent=true
# Spread load — avoids thundering-herd-style failures against Graph.
RandomizedDelaySec=2min
Unit=hyacine-run.service

[Install]
WantedBy=timers.target
